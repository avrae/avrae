# syntax=docker/dockerfile:1

FROM --platform=linux/amd64 ghcr.io/astral-sh/uv:python3.10-bookworm

RUN useradd --create-home avrae && mkdir -p /app/shared && chown -R avrae:avrae /app
USER avrae
WORKDIR /home/avrae

ENV NO_DICECLOUD=1
ENV TESTING=1

RUN mkdir shared

COPY --chown=avrae:avrae pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --group test
ENV PATH="/home/avrae/.venv/bin:${PATH}"

COPY --chown=avrae:avrae . .

ENTRYPOINT ["pytest", "tests/"]
